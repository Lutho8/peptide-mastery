# Vite environment variables (client-exposed must be prefixed with VITE_)
# Copy to .env.local for local dev, or set in Vercel -> Project Settings ->
# Environment Variables. Never commit a file with real values.

# ── Supabase (REQUIRED for auth & cloud sync) ────────────────────────────────
# URL of your Supabase project, e.g. https://<project-id>.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon) key — safe to expose client-side.
# Supabase Dashboard -> Project Settings -> API -> anon public
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── RevenueCat (optional, for in-app purchases) ──────────────────────────────
# RevenueCat public SDK key for Android (starts with goog_).
# Safe to expose client-side — this is RC's "public" key.
VITE_REVENUECAT_ANDROID_KEY=

# (Optional, for future iOS build) RevenueCat iOS public SDK key (appl_…)
VITE_REVENUECAT_IOS_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# EDGE FUNCTION SECRETS — these are NOT Vite variables.
# Set them with `supabase secrets set KEY=value` or in the Supabase dashboard
# under Edge Functions -> Secrets. Listed here for reference only.
# ─────────────────────────────────────────────────────────────────────────────

# AI — used by peptide-ai-agent, safety-check, analyze-lab-report.
# Replaces the former LOVABLE_API_KEY / ai.gateway.lovable.dev.
# OPENROUTER_API_KEY=
# AI_MODEL_DEFAULT=google/gemini-3.7-flash      # text reasoning calls
# AI_MODEL_VISION=google/gemini-3.7-flash       # lab-report OCR / vision calls
# AI_PDF_ENGINE=native                          # native | mistral-ocr | cloudflare-ai
# OPENROUTER_SITE_URL=https://peptide-south-africa.co.za
# OPENROUTER_APP_NAME=Peptide South Africa

# Google Search Console — used by gsc-status and gsc-resubmit-sitemap.
# Replaces the former connector-gateway.lovable.dev proxy.
# Full service-account JSON key, verbatim. The service account's client_email
# must be added as an Owner on the Search Console property.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Transactional email — used by process-email-queue.
# Replaces the former @lovable.dev/email-js sender.
# EMAIL_PROVIDER=resend        # "resend" or "none" (none = log only, no delivery)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@peptide-south-africa.co.za
# PUBLIC_SITE_URL=https://peptide-south-africa.co.za
